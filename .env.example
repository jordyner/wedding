# Copy to .env.local for local development. Set the same names in Vercel → Settings → Environment Variables.

# Postgres. Production: the *pooled* Neon connection string (host contains "-pooler").
# Local: run `npm run db:local` and use the line below.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# Resend (https://resend.com/api-keys). Use a key with "Sending access" only.
RESEND_API_KEY=
# Must use the domain verified in Resend, e.g. svatbajordanovi.cz
EMAIL_FROM="Svatba Jordánovi <pozvanka@svatbajordanovi.cz>"
# Optional: where guests' replies to the email go (your personal inbox).
EMAIL_REPLY_TO=

# Absolute origin used to build private edit links in emails.
PUBLIC_SITE_URL=http://localhost:3000

# Optional: connections per function instance (default 3).
# DB_POOL_MAX=3
